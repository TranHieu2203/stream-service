<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Trang chủ VBI Streaming</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/index.css" rel="stylesheet">
</head>

<body>
    <div class="main-box">
        <img src="/assets/svgs/logo_vbi.svg" alt="VBI" class="vbi-logo">
        <div class="main-title">VBI Streaming Service</div>
        <div class="main-desc">Nền tảng Streaming của Tổng Công ty Bảo hiểm VietinBank (VBI).</div>
        <div class="user-info">
            <span class="user-name"><%= user ? user.name : 'User' %></span>
        </div>
        <button onclick="goToDashboard()" class="btn btn-main">Vào Dashboard</button>
        <form action="/logout" method="POST" class="mt-3">
            <button type="submit" class="btn btn-logout">Đăng xuất</button>
        </form>
    </div>
    <script src="/js/index.js"></script>
</body>

</html>